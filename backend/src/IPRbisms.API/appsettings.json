{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=iprbisms;User=root;Password=yourpassword;"
  },
  "Jwt": {
    "Secret": "YOUR_SUPER_SECRET_KEY_MINIMUM_32_CHARS",
    "Issuer": "IPRbisms",
    "Audience": "IPRbismsUsers",
    "ExpiryMinutes": 480
  },
  "Otp": {
    "ExpiryMinutes": 10,
    "SmsApiKey": ""
  },
  "Storage": {
    "UploadPath": "uploads/",
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".pdf", ".docx", ".xlsx" ]
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/iprbisms-.log", "rollingInterval": "Day" } }
    ]
  },
  "AllowedHosts": "*"
}
